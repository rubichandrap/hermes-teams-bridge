{
  "name": "@rubichandrap/hermes-teams-bridge",
  "version": "1.0.0",
  "description": "Event-driven Hermes Agent ↔ Microsoft Teams bridge with conversation history injection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop hermes-teams-bridge",
    "logs": "pm2 logs hermes-teams-bridge",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf dist/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "hermes",
    "hermes-agent",
    "microsoft-teams",
    "power-automate",
    "bridge",
    "webhook",
    "ai-agent"
  ],
  "author": "Rubi Chandraputra",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rubichandrap/hermes-teams-bridge.git"
  }
}
