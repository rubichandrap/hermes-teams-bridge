# ── Hermes Teams Bridge — environment template ──────────────────────────────
# Copy to .env and fill in. All bridge keys are TEAMS_BRIDGE_* prefixed.
# Load order: programmatic defaults → config.json → process env → .env
#
# Docker: docker compose reads this file via env_file. Paths are container
# paths inside the Hermes data volume mounted at /opt/data.

# ── Bridge ──────────────────────────────────────────────────────────────────

# Per-agent Flow 2 URLs — REQUIRED. Replace <AGENT_ID> with the agent key
# from config.json (MAIN, ...). Falls back to TEAMS_BRIDGE_FLOW2_URL.
TEAMS_BRIDGE_FLOW2_URL_MAIN=https://prod-xx.centralindia.logic.azure.com/workflows/your-flow-2-trigger/triggers/manual/paths/invoke?api-version=2016-06-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=YOUR_SIG

# Proxy mode (true = listen on proxyPort and dispatch inbound Teams messages)
TEAMS_BRIDGE_PROXY_MODE=true

# Proxy listen port (default 18790). The proxy binds 127.0.0.1, so Docker uses
# host networking; expose it to Power Automate through a tunnel.
TEAMS_BRIDGE_PROXY_PORT=18790

# Hermes CLI binary (default: hermes on PATH; the Docker image provides it)
TEAMS_BRIDGE_HERMES_BIN=hermes

# Hermes session store inside the container (default: $HERMES_HOME/state.db).
# Native runs: use the host path, e.g. /home/user/.hermes/state.db, or omit.
# TEAMS_BRIDGE_DB_PATH=/opt/data/state.db

# Session store polling interval in ms (default 2000)
TEAMS_BRIDGE_SESSION_POLL_MS=2000

# Bearer token required by the /teams-proxy endpoint. When set, inbound
# requests must send `Authorization: Bearer <token>` (or the bare token).
# REQUIRED whenever the proxy is exposed via a public tunnel (devtunnel,
# ngrok, cloudflared) — otherwise anyone with the URL can trigger agent runs.
# Generate one with: openssl rand -hex 32
# TEAMS_BRIDGE_PROXY_TOKEN=replace-with-a-random-token

# Log level: DEBUG | INFO | WARN | ERROR | FATAL
LOG_LEVEL=INFO

# ── Docker Compose only ─────────────────────────────────────────────────────

# Host path to the Hermes data directory (must contain state.db).
HERMES_HOST_HOME=/home/user/.hermes

# UID/GID that own HERMES_HOST_HOME; the container runs as this user.
HERMES_UID=1000
HERMES_GID=1000
